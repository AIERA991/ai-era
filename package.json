    "demo:verified": "node scripts/verified-demo.mjs"
  },
  "dependencies": { "@openzeppelin/contracts": "5.4.0" },
  "devDependencies": { "solc": "0.8.30", "ethers": "6.17.0", "hardhat": "3.15.0" },
  "overrides": { "tmp": "0.2.7" }
}
