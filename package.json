{
  "name": "ai-era",
  "version": "0.2.0",
  "private": true,
  "description": "AI Era (AERA): fixed-supply token and AI task settlement prototype",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "compile": "node scripts/compile.mjs",
